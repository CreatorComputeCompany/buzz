# Generate a distinct random value in the real root-owned file. This secret is
# shared with the Buzz web API and must never be committed.
ORCA_RUNTIME_APP_TICKET_SECRET=replace-with-64-random-hex-characters

# Keep legacy ownership migration off until the reviewed lazy-claim runbook in
# README.md is approved. New worktrees are owner-scoped without this flag.
ORCA_BUZZ_LEGACY_CLAIM_ENABLED=0
